[0.007851, "o", "\r\n# Better Every Run: correction intake, not note hoarding\r\n\r\n$ ber init\r\n"]
[0.043683, "o", "# Better Every Run initialized\r\n\r\n- Store: /tmp/tmp.6cyZV6rplT/.better-every-run\r\n- Events: /tmp/tmp.6cyZV6rplT/.better-every-run/events.jsonl\r\n- Lessons: /tmp/tmp.6cyZV6rplT/.better-every-run/lessons.jsonl\r\n"]
[0.048044, "o", "\r\n# 1. Capture a human correction with the tiny /ber-shaped surface\r\n"]
[0.048061, "o", "\r\n$ ber fix agent says done without proof -> agent shows exact verification output --scope eval --tags proof,regression\r\n"]
[0.084041, "o", "# Fixed\r\n\r\n- From: agent says done without proof\r\n- To: agent shows exact verification output\r\n- Lesson: les_20260604184000_fgko\r\n- Local store: .better-every-run/\r\n- Durable file changed: none\r\n"]
[0.123808, "o", "\r\n# 2. Report shows the lesson and where it should go\r\n"]
[0.123847, "o", "\r\n$ ber report --today\r\n"]
[0.159507, "o", "# Better Every Run report (today)\r\n\r\n## Storage\r\n\r\n- Local store: .better-every-run/\r\n- Durable files changed: none\r\n\r\n## Counts\r\n\r\n- Events captured: 1\r\n- Lessons proposed: 1\r\n- Open proposals: 0\r\n- Accepted: 1\r\n- Rejected: 0\r\n- Quarantined: 0\r\n- Superseded: 0\r\n- Promoted: 0\r\n- Expired: 0\r\n\r\n## Event types\r\n\r\n- correction: 1\r\n\r\n## Recent evidence\r\n\r\n- evt_20260604184000_l6vi | correction: When this happens: agent says done without proof. Prefer this outcome: agent shows exact verification output.\r\n\r\n## Open lesson proposals\r\n\r\n- none\r\n\r\n## Promotion suggestions\r\n\r\n- les_20260604184000_fgko | eval/correction: promote to eval\r\n  Review: node scripts/ber.js card les_20260604184000_fgko --to eval --target <markdown-file>\r\n  Apply: node scripts/ber.js promote les_20260604184000_fgko --to eval --target <markdown-file> --require-card\r\n\r\n## Next action\r\n\r\nPromote accepted lessons only when they should change memory, a skill, or an eval.\r\n"]
[0.163718, "o", "\r\n# 3. Write a lesson card before touching a durable file\r\n"]
[0.163813, "o", "\r\n$ ber card les_20260604184000_fgko --to eval --target eval-target.md\r\n"]
